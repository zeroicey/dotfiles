font-family = Cascadia Code NF
font-size = 13.5
font-feature = ss01,ss02,ss03,ss19,ss20,calt
background-opacity = 0.85
background-blur = 20

# Cursor style: block, bar, underline, block_hollow
cursor-style = block

# Disable shell integration cursor override (prevents it from changing cursor to bar)
shell-integration-features = no-cursor,ssh-terminfo,ssh-env
