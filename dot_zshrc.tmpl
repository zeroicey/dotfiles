# 开启终端代理
function proxyon() {
    # 平台自适应：hpcore→hpzero 旁路由 7890（带认证，密码不入 git，从 0600 secret 读）；macOS→本机 7897
    local proxy=""
    if [[ "$(uname)" == "Darwin" ]]; then
        proxy="http://127.0.0.1:7897"
    else
        local _pf="$HOME/.config/hpcore-secrets/clash-proxy.pass"
        if [[ -r "$_pf" ]]; then
            proxy="http://Clash:$(<"$_pf")@192.168.5.10:7890"
        else
            echo "proxyon: 缺 $_pf（hpzero 代理密码），未启用代理" >&2
            return 1
        fi
    fi
    # ⚠️ no_proxy 里禁止出现裸 IPv6 子网：urllib/httpx 按 ':' 切 host:port，会把
    #    fd7a:115c:a1e0::/48 解析成 host:115c:a1e0:: 进而 httpx.Client() 抛
    #    InvalidURL: Invalid port（报错在构造阶段，请求根本没发出去）。
    #    单点回环 ::1 安全；已下线网段（EasyTier 10.126.126.2）也别留。
    local bypass="localhost,127.0.0.1,::1,hpcore,hpcore.localdomain,.local,.localdomain,.ts.net,192.168.5.3,100.103.89.5,192.168.0.0/16,100.64.0.0/10,10.0.0.0/8"
    export https_proxy="$proxy"
    export http_proxy="$proxy"
    export all_proxy="$proxy"
    export NO_PROXY="$bypass"
    export no_proxy="$bypass"
    echo -e "System proxy enable 🟢"
}

# 关闭终端代理
function proxyoff() {
    unset https_proxy
    unset http_proxy
    unset all_proxy
    unset NO_PROXY
    unset no_proxy
    echo -e "System proxy disable 🔴"
}

