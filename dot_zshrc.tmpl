# ===== hpcore 运维核心专用 =====
# 开启 sudo 免密 (NOPASSWD: ALL)
function sudoon() {
    local file="/etc/sudoers.d/90-nopasswd-${USER}"
    local tmp
    tmp="$(mktemp /tmp/sudo-nopasswd.XXXXXX)" || return 1
    printf '%s ALL=(ALL) NOPASSWD: ALL\n' "$USER" >| "$tmp"
    # 先做语法校验，避免写坏 sudoers 导致 sudo 全部失效
    if ! sudo visudo -cf "$tmp" >/dev/null 2>&1; then
        rm -f "$tmp"
        echo "❌ sudoers 语法校验失败，已中止，未做任何修改"
        return 1
    fi
    if sudo install -m 0440 -o root -g root "$tmp" "$file"; then
        echo "✅ sudo 免密已开启：${file}"
    else
        echo "❌ 写入 ${file} 失败"
    fi
    rm -f "$tmp"
}

# 关闭 sudo 免密
function sudooff() {
    local file="/etc/sudoers.d/90-nopasswd-${USER}"
    if sudo test -f "$file"; then
        sudo rm -f "$file"
        echo "🔴 sudo 免密已关闭"
    else
        echo "ℹ️   sudo 免密本来就是关闭状态"
    fi
}

# 查看 sudo 免密状态
function sudostatus() {
    local file="/etc/sudoers.d/90-nopasswd-${USER}"
    if sudo test -f "$file"; then
        echo "🟢 sudo 免密：已开启 (${file})"
    else
        echo "⚪ sudo 免密：未开启"
    fi
}

# pi 安装位置
export PATH="$HOME/.npm-global/bin:$PATH"

# 未设代理时自动开启 → 默认走 hpzero 旁路由（含 AdGuard 过滤）
# 并自愈「mihomo 下线后残留的 127.0.0.1:7890 死代理」（避免新 shell 继承失效代理）
if [[ -z "$http_proxy" && -z "$https_proxy" ]]; then
  proxyon >/dev/null 2>&1
elif [[ "$http_proxy" == *127.0.0.1:7890* || "$https_proxy" == *127.0.0.1:7890* || "$all_proxy" == *127.0.0.1:7890* ]]; then
  proxyon >/dev/null 2>&1
fi
