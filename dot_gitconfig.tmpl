[user]
	name = zeroicey
	email = zeroicey.hp@outlook.com
[safe]
	directory = *
{{ if eq .chezmoi.hostname "hpstation" }}
# hpstation 特有：GitHub 需走本地代理（mihomo/Clash 混合端口 7897）
[http]
	proxy = http://127.0.0.1:7897
[https]
	proxy = http://127.0.0.1:7897
{{ end }}
{{ if eq .chezmoi.hostname "hpcore" }}
# hpcore 特有：GitHub 认证走 gh auth
[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
{{ end }}
{{ if eq .chezmoi.hostname "hpbook" }}
# hpbook 特有：直连 github.com:443 不通（实测 lazy 插件 checkout 75s 超时）→ 与 iqibdl 同款，
# 所有 https 的 github.com 操作重写走自建 gh 代理（lazy.nvim 插件 clone 走这条路）
[url "https://gh.zeroicey.me/https://github.com/"]
	insteadOf = https://github.com/
{{ end }}
