[user]
	name = zeroicey
	email = zeroicey.hp@outlook.com
[safe]
	directory = *
{{ if eq .chezmoi.hostname "hpstation" }}
# hpstation 特有：GitHub 需走本地代理（mihomo/Clash 混合端口 7897）
[http]
	proxy = http://127.0.0.1:7897
[https]
	proxy = http://127.0.0.1:7897
{{ end }}
{{ if eq .chezmoi.hostname "hpcore" }}
# hpcore 特有：GitHub 认证走 gh auth
[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
{{ end }}
{{ if eq .chezmoi.hostname "hpbook" }}
# hpbook 特有：直连 github.com:443 不通（实测 lazy 插件 checkout 75s 超时）→ 与 iqibdl 同款，
# 所有 https 的 github.com 操作重写走自建 gh 代理（lazy.nvim 插件 clone 走这条路）
[url "https://gh.zeroicey.me/https://github.com/"]
	insteadOf = https://github.com/
{{ end }}
{{ if eq .chezmoi.hostname "bjbuwe" }}
# bjbuwe 特有（原 iqibdl，2026-09 整盘重装后改名）：**故意不写任何代理配置**，实测决定：
#  - gh.zeroicey.me 在这台机上不通（Cloudflare，直连/走代理均 000）⇒ 不套 iqibdl 那套重写
#  - 直连 github.com 可用（多次实测 200，1.7~11 s）
#  - 本机 mihomo(127.0.0.1:7890) 走 GitHub **不稳**（同一时段 6 次探测中 3 次 TLS eof/000）
# ⇒ 直连为主；需要代理时用 shell 里的 `proxyon`（env 变量）。
# ⚠️ 这里故意不写 [http] proxy：git config 会盖过 http_proxy 环境变量，
#    写了反而让 `proxyoff` 失效、代理挂了也躲不开。
{{ end }}
